{
    "name": "snowballr-frontend",
    "version": "0.1.0",
    "description": "SnowballR is a web-based tool supporting Systematic Literature Reviews (SLR).",
    "homepage": "https://github.com/SE-UUlm/snowballr-frontend",
    "bugs": {
        "url": "https://github.com/SE-UUlm/snowballr-frontend/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/SE-UUlm/snowballr-frontend.git"
    },
    "type": "module",
    "license": "GPL-3.0-or-later",
    "packageManager": "npm@11.3.0",
    "scripts": {
        "postinstall": "npm run copy-api-client-code",
        "dev": "vite dev --open",
        "build": "vite build",
        "preview": "vite preview --open",
        "prod": "npm run build && npm run preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "lint:fix": "eslint --fix .",
        "lint-md": "markdownlint --config markdownlint.json **/*.md",
        "test": "npm run test:no-e2e && npm run test:e2e",
        "show-coverage": "open coverage/index.html",
        "test:unit": "vitest --project unit",
        "test:unit:ui": "npm run test:unit -- --ui --watch --open",
        "test:integration": "vitest --project integration",
        "test:integration:ui": "npm run test:integration -- --ui --watch --open",
        "test:e2e": "node scripts/run-playwright.js test",
        "test:e2e:fast": "node scripts/run-playwright.js test --only-changed=origin/develop",
        "test:e2e:show-report": "playwright show-report e2e-report",
        "test:no-e2e": "vitest",
        "test:and-open-coverage": "npm run test && npm run show-coverage",
        "license-check": "license-checker --onlyAllow 'GPL-3.0-only;GPL-3.0-or-later;GPL-2.0-or-later;LGPL-3.0-only;LGPL-3.0-or-later;LGPL-2.1-only;LGPL-2.1-or-later;AGPL-3.0-only;AGPL-3.0-or-later;Apache-2.0;Artistic-2.0;ClArtistic;BSL-1.0;BSD-3-Clause;CC0-1.0;CECILL-2.0;BSD-3-Clause-Clear;ECL-2.0;EFL-2.0;EUDatagrid;MIT;BSD-2-Clause;FTL;HPND;iMatix;Imlib2;IJG;Intel;ISC;MPL-2.0;NCSA;OLDAP-2.7;Python-2.0;Ruby;SGI-B-2.0;SMLNJ;UPL-1.0;Unlicense;Vim;W3C;WTFPL;X11;XFree86-1.1;Zlib;ZPL-2.0;ZPL-2.1;CC-BY-4.0;BlueOak-1.0.0;0BSD;LGPL-3.0*' --excludePackages 'spdx-exceptions@2.5.0;parse-cache-control@1.0.1' --summary",
        "copy-api-client-code": "rm -rf src/lib/model/api/* && cp -r node_modules/snowballr-api/dist/* src/lib/model/api/"
    },
    "devDependencies": {
        "@internationalized/date": "^3.12.2",
        "@lucide/svelte": "^1.23.0",
        "@playwright/test": "^1.61.1",
        "@protobuf-ts/grpcweb-transport": "^2.11.1",
        "@protobuf-ts/runtime-rpc": "^2.11.1",
        "@sonar/scan": "^4.3.6",
        "@svelte-put/shortcut": "^4.1.0",
        "@sveltejs/adapter-node": "^5.3.2",
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.0",
        "@types/d3": "^7.4.3",
        "@types/eslint": "^9.6.0",
        "@types/node": "^25.2.0",
        "@vitest/coverage-v8": "^4.1.11",
        "@vitest/ui": "^4.0.18",
        "bits-ui": "^2.14.4",
        "clsx": "^2.1.1",
        "cross-fetch": "^4.1.0",
        "d3": "^7.9.0",
        "eslint": "^10.0.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.17.1",
        "eslint-plugin-tsdoc": "^0.5.2",
        "fetch-cookie": "^3.2.0",
        "fzf": "^0.5.2",
        "globals": "^17.4.0",
        "highlight-words": "^2.0.0",
        "jsdom": "^29.0.2",
        "license-checker": "^25.0.1",
        "markdownlint-cli": "^0.45.0",
        "mode-watcher": "^1.1.0",
        "prettier": "^3.8.1",
        "prettier-plugin-svelte": "3.5.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "protobuf-fieldmask": "^2.0.0",
        "resize-observer-polyfill": "1.5.1",
        "snowballr-api": "^0.16.0",
        "svelte": "^5.55.7",
        "svelte-check": "^4.3.1",
        "svelte-sonner": "^1.0.7",
        "tailwind-merge": "^3.5.0",
        "tailwind-variants": "^1.0.0",
        "tailwindcss": "^4.1.16",
        "tailwindcss-animate": "^1.0.7",
        "tough-cookie": "^5.1.2",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0",
        "vitest": "^4.0.18",
        "zod": "^4.4.3"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.12.0 || ^24.0.0",
            "onFail": "error"
        }
    }
}
